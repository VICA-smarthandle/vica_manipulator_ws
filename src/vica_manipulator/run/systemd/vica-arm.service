# VICA 로봇팔(나노) 부팅 자동 실행 — 팔·MoveIt·손목 카메라·손 인식·NX 팔 서비스를 켜고 NX 명령(/arm/demo 등)을 기다린다.
# 설치(한 번):  sudo cp ~/vica_manipulator_ws/src/vica_manipulator/run/systemd/vica-arm.service /etc/systemd/system/
#               sudo systemctl daemon-reload && sudo systemctl enable --now vica-arm
# 상태·로그:     systemctl status vica-arm   /   journalctl -u vica-arm -f
# 끄기·켜기:     sudo systemctl stop vica-arm   /   sudo systemctl start vica-arm   (켜면 팔이 홈으로 한 번 움직인다)
# 자동 실행 해제: sudo systemctl disable vica-arm
[Unit]
Description=VICA arm (nano): arm, MoveIt, camera, hand guard, NX arm service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user/vica_manipulator_ws/src/vica_manipulator
ExecStart=/bin/bash /home/user/vica_manipulator_ws/src/vica_manipulator/run/boot.sh
KillSignal=SIGINT
TimeoutStopSec=40
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
